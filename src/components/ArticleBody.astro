---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import ArticleCta from './ArticleCta.astro';

interface Props {
  entry: CollectionEntry<'articles'>;
}

const { entry } = Astro.props;
const slug = entry.id;

// The content layer renders the markdown ahead of time, so we can split the
// HTML and drop a CTA mid-article — after the first <h2> section, i.e. just
// before the second <h2>. Articles are plain markdown (no imported images and
// no framework components), so the cached HTML is equivalent to <Content />,
// and this saves article authors from hand-placing a marker.
const html = entry.rendered?.html ?? '';

/** Split just before the second <h2>, or return null when there isn't one. */
function splitBeforeSecondH2(source: string): [string, string] | null {
  const h2 = /<h2[\s>]/gi;
  let match: RegExpExecArray | null;
  let count = 0;
  while ((match = h2.exec(source)) !== null) {
    count += 1;
    if (count === 2) {
      return [source.slice(0, match.index), source.slice(match.index)];
    }
  }
  return null;
}

const split = html ? splitBeforeSecondH2(html) : null;

// Fall back to the standard render path when the content layer has no cached
// HTML for this entry (e.g. a loader that defers rendering).
const { Content } = html ? { Content: null } : await render(entry);
---

{
  Content ? (
    <div class="prose mt-10">
      <Content />
    </div>
  ) : split ? (
    <>
      <div class="prose mt-10" set:html={split[0]} />
      {/* Mid-article CTA: after the first section, before the next heading. */}
      <ArticleCta slug={slug} />
      <div class="prose" set:html={split[1]} />
    </>
  ) : (
    /* Short article with fewer than two H2s — the closing CTA is enough. */
    <div class="prose mt-10" set:html={html} />
  )
}
