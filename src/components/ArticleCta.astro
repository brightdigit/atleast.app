---
import { APP_STORE_URL, PRIMARY_CTA, TESTFLIGHT_URL } from '../config';

interface Props {
  /** Article slug — becomes data-tf-location="article-<slug>". */
  slug: string;
  heading?: string;
  body?: string;
  class?: string;
}

const {
  slug,
  heading = 'Find your minimum.',
  body = 'Set a floor, feel the rhythm, and let the silence tell you you’re done. AtLeast runs on your Apple Watch — no account, no alarm, nothing to watch.',
  class: className,
} = Astro.props;

// PRIMARY_CTA in src/config.ts is the single source of truth. At launch, set
// APP_STORE_URL and flip PRIMARY_CTA; every article picks this up automatically.
const isAppStore = PRIMARY_CTA === 'appstore';
const href = isAppStore ? APP_STORE_URL : TESTFLIGHT_URL;
const label = isAppStore ? 'Download on the App Store' : 'Join the beta on TestFlight';
---

<aside
  class:list={[
    'my-12 rounded-2xl border border-brand-border bg-brand-surface p-8 text-center',
    className,
  ]}
>
  <h2 class="mb-3 text-xl font-semibold text-brand-text">{heading}</h2>
  <p class="mx-auto mb-6 max-w-xl text-base leading-relaxed text-brand-muted">{body}</p>
  <a
    href={href}
    target="_blank"
    rel="noopener noreferrer"
    data-testflight-link
    data-tf-location={`article-${slug}`}
    class="inline-flex items-center gap-3 rounded-2xl border border-brand-border bg-brand-bg px-6 py-3.5 text-sm font-semibold text-brand-text transition-opacity hover:opacity-80"
  >
    {isAppStore ? (
      <img
        src="/app-store-badge.svg"
        alt="Download AtLeast on the App Store"
        width="120"
        height="40"
        class="h-10 w-auto"
        loading="lazy"
      />
    ) : (
      label
    )}
  </a>
</aside>
