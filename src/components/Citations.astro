---
import { Icon } from 'astro-icon/components';

interface Props {
  citations: { text: string; url: string }[];
}

const { citations } = Astro.props;
---

{citations.length > 0 && (
  <section class="mt-16">
    <h2 class="flex items-center gap-3 text-2xl font-semibold tracking-tight">
      <Icon name="ph:books" class="h-6 w-6 text-brand-accent" />
      References
    </h2>
    <ol class="mt-6 space-y-3 text-sm leading-relaxed text-brand-muted">
      {citations.map((c, i) => (
        <li id={`ref-${i + 1}`} class="flex scroll-mt-24 gap-3">
          <span class="flex-shrink-0 text-brand-muted">[{i + 1}]</span>
          <a href={c.url} target="_blank" rel="noopener noreferrer" class="text-brand-accent hover:underline">
            {c.text}
          </a>
        </li>
      ))}
    </ol>
  </section>
)}
