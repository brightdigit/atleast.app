---
import { Icon } from 'astro-icon/components';

interface Props {
  icon: string;
  label: string;
  blurb: string;
  anchor: string;
}

const { icon, label, blurb, anchor } = Astro.props;
---

<!-- Jump-grid bookmark. On phones it is a compact icon + label tile (blurb hidden);
     from sm up it shows the blurb as a full card. -->
<a
  href={anchor}
  class="flex flex-col items-center rounded-2xl border border-brand-border bg-brand-surface p-4 text-center transition-colors hover:border-brand-accent/50 sm:items-start sm:p-6 sm:text-left"
>
  <Icon name={icon} class="mb-2 h-10 w-10 text-brand-accent sm:mb-3 sm:h-8 sm:w-8" />
  <span class="block text-sm font-semibold leading-snug text-brand-text sm:mb-1 sm:text-base">{label}</span>
  <p class="hidden text-sm leading-relaxed text-brand-muted sm:block">{blurb}</p>
</a>
