---
import { Icon } from 'astro-icon/components';

interface Props {
  icon: string;
  id?: string;
  // One-line title shown on phones in place of a long heading. The full heading
  // stays in the <h2> (screen-reader only below sm) so its text and name don't change.
  short?: string;
}

const { icon, id, short } = Astro.props;
---

<div id={id} class:list={['mt-10 flex flex-col gap-3 sm:mt-16 sm:flex-row sm:items-center sm:gap-4', id && 'scroll-mt-24']}>
  <!-- Phones: a large bare icon above the title, left-aligned with it. sm+: the small bordered tile
       inline with the title. -->
  <span
    class="flex w-full flex-shrink-0 items-center justify-start sm:h-11 sm:justify-center sm:w-11 sm:rounded-xl sm:border sm:border-brand-border sm:bg-brand-surface"
  >
    <Icon name={icon} class="h-12 w-12 text-brand-accent sm:h-6 sm:w-6" />
  </span>
  <h2 class="truncate text-xl font-semibold tracking-tight sm:overflow-visible sm:whitespace-normal sm:text-3xl">
    {short ? (
      <>
        <span aria-hidden="true" class="sm:hidden">{short}</span>
        <span class="sr-only sm:not-sr-only"><slot /></span>
      </>
    ) : (
      <slot />
    )}
  </h2>
</div>
