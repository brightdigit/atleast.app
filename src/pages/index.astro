---
import Layout from '../layouts/Layout.astro';
import StepCard from '../components/StepCard.astro';
import UseCaseCard from '../components/UseCaseCard.astro';
import FeatureRow from '../components/FeatureRow.astro';
import AppStoreBadge from '../components/AppStoreBadge.astro';
import HealthBadge from '../components/HealthBadge.astro';
import AppIconRings from '../components/AppIconRings.astro';
import Schema from '../components/Schema.astro';
import { PRICING } from '../config';

const steps = [
  {
    step: 1,
    title: 'Set your minimum',
    description: 'Choose a duration (1–60 min) and tap interval.',
  },
  {
    step: 2,
    title: 'Feel the rhythm',
    description: 'Gentle haptic taps keep you present without distraction.',
  },
  {
    step: 3,
    title: 'Silence means done',
    description: 'When taps stop, you\'ve reached your goal. No alarm. No interruption.',
  },
];

const useCases = [
  { emoji: '🧘', label: 'Meditation', description: 'Stay present without watching the clock.' },
  { emoji: '🧊', label: 'Cold exposure', description: 'Know when your minimum is reached — eyes-free.' },
  { emoji: '🧘‍♀️', label: 'Yoga & stretching', description: 'Hold poses with a gentle rhythm guiding you.' },
  { emoji: '🏋️', label: 'Static holds', description: 'Planks, wall sits — feel the time without seeing it.' },
  { emoji: '💻', label: 'Focused work', description: 'Pomodoro-style sessions with silent completion.' },
];

const features = [
  {
    icon: '🔕',
    heading: 'No jarring alarm.',
    description: 'Traditional timers interrupt the very state you\'re trying to maintain. <em>AtLeast</em> inverts this — taps encourage you during practice and go silent when you\'ve earned it.',
  },
  {
    icon: '⌚',
    heading: 'Eyes-free, by design.',
    description: 'Built for Apple Watch. No screen-checking, no distractions. Just gentle taps on your wrist.',
  },
  {
    icon: '🌱',
    heading: '"At least" mindset.',
    description: 'Setting a minimum threshold, not a hard deadline. More forgiving. More human.',
  },
];

// Session Type is chosen per timer and decides how a finished session is saved
// to Apple Health. Writing to Health is free; the types marked `pro` need
// AtLeast Pro (see the support FAQ).
// Free vs Pro, matching /support and the App Store description. Prices come from PRICING.
const plans = [
  {
    name: 'Free',
    items: ['The haptic timer and built-in timers', 'Mindful Minutes and Yoga saved to Apple Health', 'The iPhone companion'],
  },
  {
    name: 'AtLeast Pro',
    items: ['Save your own timers', 'History, with streaks and quiet minutes', 'Every Session Type'],
  },
];

// Rendered as a table from sm up and as stacked cards on phones.
const comparison = [
  { feature: 'Screen required', atleast: 'No — haptic only', traditional: 'Yes' },
  { feature: 'Works offline', atleast: 'Fully offline', traditional: 'Often requires internet' },
  { feature: 'Platform', atleast: 'Apple Watch native, optional iPhone companion', traditional: 'iPhone-based' },
  { feature: 'End signal', atleast: 'Gentle silence', traditional: 'Jarring alarm' },
];

const sessionTypes = [
  { label: 'Mindful Minutes', pro: false },
  { label: 'Yoga', pro: false },
  { label: 'Mind & Body', pro: true },
  { label: 'Flexibility', pro: true },
  { label: 'Cooldown', pro: true },
  { label: 'Core Training', pro: true },
  { label: 'Traditional Strength', pro: true },
];

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'AtLeast',
  applicationCategory: 'HealthApplication',
  operatingSystem: 'watchOS 26.0, iOS 26.0',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  description:
    'AtLeast is a passive haptic timer for Apple Watch that uses gentle taps to mark time intervals during meditation, breathwork, and cold plunge sessions — no screens, just rhythm. An optional iPhone companion lets you pre-load a timer and mirror the live session.',
  featureList: [
    'Haptic-only timers — no screen required',
    'Works completely offline',
    'Perfect for meditation, breathwork, and cold plunge',
    'Apple Watch native app',
    'Optional iPhone companion — pre-load a timer and mirror the live session',
    'Saves finished sessions to Apple Health as Mindful Minutes or a workout',
  ],
};

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'How to use AtLeast timer on Apple Watch',
  description: 'Set up a passive haptic timer on Apple Watch in 3 simple steps.',
  step: steps.map((s) => ({
    '@type': 'HowToStep',
    name: s.title,
    text: s.description,
  })),
};
---

<Layout
  title="AtLeast — Passive Timer for Apple Watch"
  description="Gentle haptic taps during your practice. Silence means done. No alarm. No interruption. A mindful timer for meditation, cold plunge, yoga, and focused work."
>
  <Schema schema={softwareSchema} />
  <Schema schema={howToSchema} />

  <!-- Hero. Full-bleed: the negative top margin cancels the layout's pt-16 so the
       media runs under the translucent nav, and overflow-hidden clips the
       parallax overhang. -->
  <section class="hero relative -mt-16 flex min-h-[80vh] items-end overflow-hidden md:min-h-[95vh]">
    <!-- Media box extends above the section so the watch sits in the upper part of the hero, clear of the headline. -->
    <div class="hero-media absolute inset-x-0 bottom-0 -top-[25%]">
      <video
        class="hero-loop h-full w-full object-cover object-[35%_50%]"
        autoplay
        loop
        muted
        playsinline
        preload="metadata"
        width="1600"
        height="898"
        poster="/demo/atleast-loop-poster.jpg"
        aria-label="Looping animation of AtLeast tapping an Apple Watch"
      >
        <source src="/demo/atleast-loop.mp4" type="video/mp4" />
        <source src="/demo/atleast-loop.webm" type="video/webm" />
      </video>
      <img
        src="/demo/atleast-loop-poster.jpg"
        alt="Overhead view of a seated person resting their hands in their lap, with concentric rings radiating from the AtLeast timer on their Apple Watch."
        width="1600"
        height="898"
        class="hero-loop-fallback h-full w-full object-cover object-[35%_50%]"
        loading="eager"
      />
    </div>
    <div
      class="absolute inset-0 bg-gradient-to-t from-brand-bg from-0% via-brand-bg/55 via-30% to-transparent to-60%"
      aria-hidden="true"
    >
    </div>
    <div class="relative z-10 mx-auto w-full max-w-5xl px-6 pb-16 pt-72 text-center md:pt-96">
      <h1 class="text-5xl font-bold tracking-tight drop-shadow-lg md:text-6xl lg:text-7xl">
        Done when the silence comes.
      </h1>
      <p class="mx-auto mt-6 max-w-xl text-lg leading-relaxed text-brand-text/80 drop-shadow-md">
        <em>AtLeast</em> taps your Apple Watch gently during your practice. When tapping stops, you've reached your minimum.
      </p>
      <p class="sr-only">
        <em>AtLeast</em> is a passive haptic timer for Apple Watch. It uses gentle taps to mark time intervals during meditation, breathwork, and cold plunge sessions — no screens, just rhythm.
      </p>
      <AppStoreBadge class="mt-8" size="xl" />
    </div>
  </section>

  <!-- App icon divider -->
  <section class="flex justify-center px-6 pt-12 md:pt-24">
    <AppIconRings />
  </section>

  <!-- How It Works -->
  <section class="px-6 py-12 md:py-24">
    <div class="mx-auto max-w-5xl">
      <h2 class="mb-12 text-center text-3xl font-semibold md:text-4xl">How does <em>AtLeast</em> work?</h2>
      <div class="grid gap-6 md:grid-cols-3">
        {steps.map((s) => <StepCard {...s} />)}
      </div>
    </div>
  </section>

  <!-- iPhone Companion -->
  <section class="px-6 py-12 md:py-24">
    <div class="mx-auto max-w-3xl text-center">
      <div class="mx-auto mb-12 max-w-2xl">
        <video
          class="h-auto w-full rounded-2xl"
          autoplay
          loop
          muted
          playsinline
          preload="metadata"
          poster="/demo/atleast-demo-poster.jpg"
          aria-label="An Apple Watch and iPhone side by side. Selecting a timer on iPhone starts a session on the Watch, and the iPhone mirrors the gentle haptic taps in real time."
        >
          <source src="/demo/atleast-demo.mp4" type="video/mp4" />
          <source src="/demo/atleast-demo.webm" type="video/webm" />
          <img
            src="/demo/atleast-demo-poster.jpg"
            alt="An Apple Watch and iPhone side by side, showing AtLeast mirroring a live timer session between the two devices."
            class="h-auto w-full rounded-2xl"
            loading="lazy"
          />
        </video>
      </div>
      <h2 class="mb-4 text-3xl font-semibold md:text-4xl">Set it on iPhone. Feel it on your wrist.</h2>
      <p class="mx-auto max-w-xl text-lg leading-relaxed text-brand-muted">
        Pre-load and pick a timer on your iPhone, then start the session from your Apple Watch. Your iPhone mirrors the live session in real time — while the gentle taps stay where they belong, on your wrist. The companion is entirely optional; the Watch remains the core, eyes-free experience.
      </p>
    </div>
  </section>

  <!-- Apple Health -->
  <section class="px-6 py-12 md:py-24">
    <div class="mx-auto max-w-3xl text-center">
      <HealthBadge class="mb-6" size="lg" note={false} />
      <h2 class="mb-4 text-3xl font-semibold md:text-4xl">Your practice, counted in Apple Health.</h2>
      <p class="mx-auto mb-10 max-w-xl text-lg leading-relaxed text-brand-muted">
        Give a timer a Session Type and each finished session lands in your Health app — as Mindful Minutes, or as a workout such as Yoga or Core Training. It's chosen per timer, so a sit and a stretch can each be counted as what they were. Leave the type off and nothing is written. <em>AtLeast</em> only writes to Health, never reads it, and the record stays in your own Health app. Saving to Health is free; <em>AtLeast</em> Pro unlocks the full range of session types.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        {sessionTypes.map((t) => (
          <span class="flex items-center gap-2 rounded-full border border-brand-border bg-brand-surface px-5 py-2.5 text-sm text-brand-muted">
            {t.label}
            {t.pro && <span class="text-xs font-medium text-brand-pulse">Pro</span>}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- AtLeast Pro -->
  <section class="px-6 py-12 md:py-24">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="mb-4 text-3xl font-semibold md:text-4xl"><em>AtLeast</em> Pro, when you want more.</h2>
      <p class="mx-auto mb-10 max-w-xl text-lg leading-relaxed text-brand-muted">
        The timer, saving to Apple Health, and the iPhone companion are free. Pro is optional.
      </p>
      <div class="grid gap-4 text-left sm:grid-cols-2">
        {plans.map((plan) => (
          <div class="rounded-2xl border border-brand-border bg-brand-surface p-6">
            <h3 class="mb-3 text-lg font-semibold text-brand-text">{plan.name}</h3>
            <ul class="space-y-2 text-base leading-relaxed text-brand-muted">
              {plan.items.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        ))}
      </div>
      <p class="mt-6 text-sm text-brand-muted">
        Monthly {PRICING.pro.monthly} · Annual {PRICING.pro.annual} with a {PRICING.pro.annualTrial} · <em>AtLeast</em> Founder {PRICING.pro.lifetime}
      </p>
      <p class="mt-4 text-base">
        <a href="/support/#pro" class="text-brand-accent hover:underline">Questions about Pro?</a>
      </p>
    </div>
  </section>

  <!-- Use Cases -->
  <section class="px-6 py-12 md:py-24">
    <div class="mx-auto max-w-5xl">
      <h2 class="mb-12 text-center text-3xl font-semibold md:text-4xl">Built for practice</h2>
      <div class="grid gap-4 sm:grid-cols-2 md:grid-cols-5">
        {useCases.map((uc) => <UseCaseCard {...uc} />)}
      </div>
    </div>
  </section>

  <!-- Why AtLeast -->
  <section class="px-6 py-12 md:py-24">
    <div class="mx-auto max-w-3xl">
      <h2 class="mb-12 text-center text-3xl font-semibold md:text-4xl">Why choose <em>AtLeast</em>?</h2>
      <div class="space-y-10">
        {features.map((f) => <FeatureRow {...f} />)}
      </div>
    </div>
  </section>

  <!-- Comparison -->
  <section class="px-6 py-12 md:py-24">
    <div class="mx-auto max-w-3xl">
      <h2 class="mb-12 text-center text-3xl font-semibold md:text-4xl"><em>AtLeast</em> vs traditional timer apps</h2>
      <div class="hidden overflow-x-auto rounded-2xl border border-brand-border sm:block">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-brand-border bg-brand-surface">
              <th class="px-6 py-4 text-left font-medium text-brand-muted">Feature</th>
              <th class="px-6 py-4 text-left font-semibold text-brand-text"><em>AtLeast</em></th>
              <th class="px-6 py-4 text-left font-medium text-brand-muted">Traditional apps</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-brand-border">
            {comparison.map((row, i) => (
              <tr class:list={[i % 2 === 0 && 'bg-brand-surface/50']}>
                <td class="px-6 py-4 text-brand-muted">{row.feature}</td>
                <td class="px-6 py-4 text-brand-accent">{row.atleast}</td>
                <td class="px-6 py-4 text-brand-muted">{row.traditional}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <dl class="divide-y divide-brand-border rounded-2xl border border-brand-border bg-brand-surface/50 sm:hidden">
        {comparison.map((row) => (
          <div class="px-5 py-4">
            <dt class="mb-2 text-sm font-medium text-brand-text">{row.feature}</dt>
            <dd class="flex justify-between gap-4 text-sm">
              <span class="text-brand-muted"><em>AtLeast</em></span>
              <span class="text-right text-brand-accent">{row.atleast}</span>
            </dd>
            <dd class="mt-1 flex justify-between gap-4 text-sm">
              <span class="text-brand-muted">Traditional apps</span>
              <span class="text-right text-brand-muted">{row.traditional}</span>
            </dd>
          </div>
        ))}
      </dl>
      <p class="mt-6 text-center text-sm text-brand-muted">
        See how <em>AtLeast</em> compares to the built-in Apple Watch Timer, the Mindfulness app, and
        named third-party apps in the full
        <a href="/compare" class="text-brand-accent underline underline-offset-2 hover:no-underline">comparison table</a>.
      </p>
    </div>
  </section>

  <!-- Guides -->
  <section class="px-6 py-12 md:py-24">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="mb-4 text-3xl font-semibold md:text-4xl">Guides for your practice</h2>
      <p class="mx-auto mb-10 max-w-xl text-lg leading-relaxed text-brand-muted">
        How to pace a practice by feel instead of by screen — start with the guide closest to yours.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a href="/breathing-pacer" class="rounded-full border border-brand-border bg-brand-surface px-5 py-2.5 text-sm text-brand-text transition-colors hover:border-brand-accent/50">
          Breathing pacer
        </a>
        <a href="/apple-watch-meditation-timer" class="rounded-full border border-brand-border bg-brand-surface px-5 py-2.5 text-sm text-brand-text transition-colors hover:border-brand-accent/50">
          Apple Watch meditation timer
        </a>
        <a href="/cold-plunge-timer" class="rounded-full border border-brand-border bg-brand-surface px-5 py-2.5 text-sm text-brand-text transition-colors hover:border-brand-accent/50">
          Cold plunge timer
        </a>
        <a href="/timer-that-vibrates" class="rounded-full border border-brand-border bg-brand-surface px-5 py-2.5 text-sm text-brand-text transition-colors hover:border-brand-accent/50">
          Timer that vibrates
        </a>
      </div>
      <p class="mt-8 text-base text-brand-muted">
        <a href="/guides" class="text-brand-accent hover:underline">Browse all guides</a>
      </p>
    </div>
  </section>

  <!-- Simplicity -->
  <section class="px-6 py-12 md:py-24">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="mb-4 text-3xl font-semibold md:text-4xl">Simple by design.</h2>
      <p class="mx-auto mb-10 max-w-xl text-lg leading-relaxed text-brand-muted">
        No account required. Your Apple Watch is all you need — with an optional iPhone companion when you want it.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-6">
        <span class="flex items-center gap-2 rounded-full border border-brand-border bg-brand-surface px-5 py-2.5 text-sm text-brand-muted">
          <span class="text-base">👤</span> No account required
        </span>
        <span class="flex items-center gap-2 rounded-full border border-brand-border bg-brand-surface px-5 py-2.5 text-sm text-brand-muted">
          <span class="text-base">⌚</span> Runs on Apple Watch
        </span>
        <span class="flex items-center gap-2 rounded-full border border-brand-border bg-brand-surface px-5 py-2.5 text-sm text-brand-muted">
          <span class="text-base">📴</span> Works offline
        </span>
      </div>
    </div>
  </section>
  <!-- Swaps the hero loop for its poster when a browser refuses muted autoplay
       (Safari per-site Auto-Play, Low Power Mode), so no dead play button is
       left on a decorative video. External file: CSP is script-src 'self'. -->
  <script src="/hero-video.js" is:inline></script>
</Layout>
